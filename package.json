{
  "name": "moyu-reader",
  "version": "1.0.1",
  "private": true,
  "description": "A quiet local TXT and EPUB reader for Windows",
  "author": "xfish987",
  "repository": {
    "type": "git",
    "url": "https://github.com/xfish987/moyu-reader.git"
  },
  "homepage": "https://github.com/xfish987/moyu-reader#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "node test-chunks.cjs && node test-text-encodings.cjs",
    "dist": "npm run build && electron-builder --win portable",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.10",
    "chardet": "^2.1.0",
    "epubjs": "^0.3.93",
    "iconv-lite": "^0.6.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.local.moyureader",
    "productName": "墨读阅读器",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "墨读阅读器.exe",
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "墨读阅读器.exe"
    },
    "directories": {
      "output": "release"
    }
  }
}
