{
  "name": "moyu-reader",
  "version": "2.2.7",
  "private": true,
  "type": "module",
  "description": "A quiet local TXT and EPUB reader for Windows and Android",
  "author": "xfish987",
  "repository": {
    "type": "git",
    "url": "https://github.com/xfish987/moyu-reader.git"
  },
  "homepage": "https://github.com/xfish987/moyu-reader#readme",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "test": "node test-chunks.cjs && node test-text-encodings.cjs && node test-conversion.mjs && node test-entity-profiles.mjs && node test-model-catalog.mjs && node test-json-repair.mjs && node test-excerpt-select.mjs && node test-luna-prompt.mjs && node test-dictionary-prompt.mjs && node test-companion-prompt.mjs && node test-storyline.mjs && node test-shelf-layout.mjs && node test-epub-direction.mjs",
    "dist": "npm run build && electron-builder --win portable msi",
    "preview": "vite preview --host 127.0.0.1",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@xmldom/xmldom": "0.9.10",
    "chardet": "^2.1.0",
    "epubjs": "^0.3.93",
    "iconv-lite": "^0.6.3",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.9",
    "opencc-js": "1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.local.moyureader.uib",
    "productName": "墨读阅读器",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.ico",
      "package.json",
      "!node_modules/@capacitor/android/**/*",
      "!node_modules/@capacitor/*/android/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "msi"
      ],
      "artifactName": "MoyuReader-${version}.${ext}",
      "icon": "assets/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "epub"
        ],
        "name": "电子书",
        "description": "TXT 或 EPUB 电子书",
        "role": "Viewer"
      }
    ],
    "portable": {
      "artifactName": "MoyuReader-${version}.exe"
    },
    "msi": {
      "artifactName": "MoyuReader-${version}-Setup.msi",
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "墨读阅读器",
      "additionalLightArgs": [
        "-cultures:zh-cn"
      ]
    },
    "msiProjectCreated": "scripts/fix-msi-codepage.cjs",
    "directories": {
      "output": "release"
    }
  }
}
